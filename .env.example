# Same Postgres as lemmido_backend (better-auth stores users/sessions there)
DATABASE_URL=postgres://lemmido:lemmido_dev@localhost:5432/lemmido

# Must match JWT_SECRET in lemmido_backend/.env
JWT_SECRET=change-me

# better-auth: any long random string (openssl rand -hex 32) and this app's own URL
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# AWS Cognito app client (callback URL: <BETTER_AUTH_URL>/api/auth/callback/cognito)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=
COGNITO_USER_POOL_ID=

# Browser-side, baked in at build time
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8080
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
